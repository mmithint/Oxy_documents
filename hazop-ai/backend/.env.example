# Azure OpenAI
AZURE_OPENAI_ENDPOINT=your-key-here
AZURE_OPENAI_API_KEY=FYyour-key-here
AZURE_OPENAI_API_VERSION=your-key-here
AZURE_OPENAI_DEPLOYMENT=your-key-here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-key-here

# Azure Document Intelligence
AZURE_DOC_INTELLIGENCE_ENDPOINT=your-key-here
AZURE_DOC_INTELLIGENCE_KEY=your-key-here
# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-key-here
AZURE_STORAGE_CONTAINER=your-key-here

# MongoDB (Local or Azure Cosmos DB MongoDB vCore)
# Local:  mongodb://localhost:27017/
# Cosmos: mongodb+srv://user:pass@your-cluster.mongocluster.cosmos.azure.com/
COSMOS_CONNECTION_STRING=your-key-here
COSMOS_DATABASE_NAME=your-key-here

# Anthropic Claude API (GPT vs Claude comparison feature)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
